{{!
    @template tiny_haccgen_extender/components/interactive-html-editor

    Structured editor for generated interactive HTML.

    @copyright 2026, Dynamic Pixel
    @license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="dp-ai-ie" data-layout="{{layout}}">
    {{#hint}}
    <p class="dp-ai-ie-hint">{{hint}}</p>
    {{/hint}}
    <div class="dp-ai-ie-split">
        <div class="dp-ai-ie-col">
            <div class="dp-ai-ie-list" data-role="list"></div>
            <div class="dp-ai-ie-list-actions">
                <button type="button" class="dp-ai-ie-btn" data-role="add">{{addlabel}}</button>
                <label class="dp-ai-ie-raw-toggle">
                    <input type="checkbox" data-role="rawtoggle" {{#rawmode}}checked{{/rawmode}} />
                    {{rawlabel}}
                </label>
            </div>
            <textarea class="dp-ai-ie-raw" data-role="raw" {{^rawmode}}hidden{{/rawmode}}></textarea>
        </div>
        <div class="dp-ai-ie-col dp-ai-ie-col--preview">
            <p class="dp-ai-ie-preview-label">{{previewlabel}}</p>
            <iframe class="dp-ai-interactive-iframe dp-ai-ie-preview" data-role="preview" title="{{previewlabel}}"></iframe>
        </div>
    </div>
</div>
