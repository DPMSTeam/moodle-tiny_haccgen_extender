{{!
    @template tiny_haccgen_extender/components/inline-help-icon

    Field label with Moodle help icon. Help text toggles inside the Tiny dialog.

    Context variables required for this template:
    * label - Field label text.
    * helptitle - Accessible name for the help control.
    * helptext - Help body shown under the label.
    * hashelp - Whether to render the help icon and text.
    * fieldname - Dialog field name used to show/hide this row.

    @copyright 2026, Dynamic Pixel
    @license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "label": "Script mode",
        "helptitle": "Script mode",
        "helptext": "AI storyboard writes the script for you.",
        "hashelp": true,
        "fieldname": "use_storyboard"
    }
}}
<div class="dp-ai-x-field-help-block dp-ai-x-field--{{fieldname}}" data-field="{{fieldname}}">
    <div class="dp-ai-x-field-label-row">
        <span class="dp-ai-x-field-label-text">{{label}}</span>
        {{#hashelp}}
        <span class="dp-ai-x-inline-help" tabindex="0" aria-label="{{helptitle}}">
            <span class="dp-ai-x-help-glyph" aria-hidden="true">?</span>
        </span>
        {{/hashelp}}
    </div>
    {{#hashelp}}
    <div class="dp-ai-x-help-popover" hidden>{{helptext}}</div>
    {{/hashelp}}
</div>
