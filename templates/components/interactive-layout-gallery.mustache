{{!
    @template tiny_haccgen_extender/components/interactive-layout-gallery

    Visual layout picker for interactive HTML generation.

    Context variables:
    * layoutlabel
    * layouts[] with id, label, hint, sketchsvg, selected

    @copyright 2026, Dynamic Pixel
    @license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "layoutlabel": "Layout",
        "layouts": [
            {
                "id": "accordion",
                "label": "Accordion",
                "hint": "Expand one topic at a time",
                "sketchsvg": "<svg></svg>",
                "selected": true
            }
        ]
    }
}}
<div class="dp-ai-layout-wrap">
    <p class="dp-ai-layout-label">{{layoutlabel}}</p>
    <div class="dp-ai-layout-grid" role="listbox" aria-label="{{layoutlabel}}">
        {{#layouts}}
        <button type="button"
            class="dp-ai-layout-card{{#selected}} is-selected{{/selected}}"
            data-layout="{{id}}"
            role="option"
            aria-selected="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">
            <span class="dp-ai-layout-card__sketch" aria-hidden="true">{{{sketchsvg}}}</span>
            <span class="dp-ai-layout-card__title">{{label}}</span>
            <span class="dp-ai-layout-card__hint">{{hint}}</span>
        </button>
        {{/layouts}}
    </div>
</div>
